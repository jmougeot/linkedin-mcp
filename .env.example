# ============================================================================
# LinkedIn MCP — variables d'environnement (copie ce fichier en .env, remplis-le)
# ============================================================================

# --- Jeton d'accès (OBLIGATOIRE en mode VM) ---------------------------------
# Protège l'accès à ta session LinkedIn. Sert à la fois :
#   - au connecteur MCP  : URL = https://linkedin.azerit.tech/mcp/<LI_TOKEN>
#   - à l'extension       : champ « Jeton d'accès » du popup (Bearer)
# Génère-le : node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
LI_TOKEN=change-me-long-random-string

# --- Quotas anti-ban (optionnel) --------------------------------------------
# Les baisser est sûr ; les gonfler augmente le risque de restriction du compte.
# LI_CAP_INVITE=20
# LI_CAP_MESSAGE=40
# LI_CAP_VIEW=80          # visites de profil/jour — l'action la plus surveillée
# LI_CAP_READ=150         # lectures légères/jour (messagerie, conversations)
# LI_MIN_GAP_S=45
# LI_MAX_GAP_S=120
# LI_VIEW_MIN_GAP_S=20
# LI_VIEW_MAX_GAP_S=60
# LI_READ_MIN_GAP_S=4
# LI_READ_MAX_GAP_S=12

# --- Rythme « humain » (optionnel) ------------------------------------------
# Une boucle à débit constant se repère bien plus vite qu'un volume élevé mais
# irrégulier : ces réglages cassent la régularité.
# LI_CAP_HOUR=40          # actions/heure, tous types (fenêtre glissante)
# LI_CAP_HOUR_VIEW=15     # visites de profil/heure
# LI_BURST_MIN=8          # micro-pause après 8 à 16 actions d'affilée…
# LI_BURST_MAX=16
# LI_BREAK_MIN_S=90       # …d'une durée de 1 min 30 à 4 minutes
# LI_BREAK_MAX_S=240
# LI_ACTIVE_START=8       # plage d'activité (envois + visites de profil only)
# LI_ACTIVE_END=20        # mettre START=END désactive la plage
# LI_TZ=Europe/Paris
# LI_SKIP_WEEKEND=0       # 1 = aucun envoi ni visite le samedi/dimanche

# LI_TRANSPORT, LI_MCP_PORT et LI_BIND sont fixés par docker-compose.server.yml
# (http / 3210 / 0.0.0.0). Inutile de les mettre ici.
