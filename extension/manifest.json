{
  "manifest_version": 3,
  "name": "LinkedIn MCP — Claude",
  "version": "0.1.0",
  "description": "Exécute en douceur, dans votre propre session LinkedIn, les invitations/messages demandés par Claude via le serveur MCP local. La cadence (quotas, délais) est imposée par le serveur.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn MCP — Claude"
  }
}
